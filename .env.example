# Backend — loaded automatically by backend/server.py (local dev) and by
# template.yaml's Environment.Variables (deployed Lambda, Gemini only).
GEMINI_API_KEY=your-gemini-api-key

# search_jobs primitive tool (backend/src/tools.py) — real job search via
# Adzuna's API (free tier: developer.adzuna.com), not scraping. Without these,
# search_jobs returns {"status": "no_credentials", ...} rather than failing
# silently; the agent can still use fetch_page for everything else.
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key

# Local LLM (dev-only — a deployed Lambda cannot reach your machine's Ollama).
# Cascade order is always Gemini -> Ollama; set LLM_PROVIDER=ollama to force
# local-only (e.g. offline dev, or to avoid Gemini API cost entirely).
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5

# Production (droplet) only — bounds worst-case Gemini spend from public
# traffic on /bootstrap and /agent. Requests with provider=ollama are exempt
# (they cost nothing). See deploy/ and DEPLOY.md.
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=50

# Frontend — leave empty for local dev (Vite proxy handles routing to localhost:3000)
VITE_API_URL=
