// One case per line: {"id", "purpose", "agent_type"?, "spec"?, "expect"?}. Lines starting with // are skipped.
// expect keys (all optional, all deterministic): tools_any, tools_none (substrings of tool names / mcp_tool names),
// mcp_servers (server ids from mcp_registry.py: time, fetch, search), min_tools, max_tools, persona (true = must have one).
// Purposes in the first block are real ones from data/bootstrap_memory.json, in the Setup screen's template wording.
{"id": "research_quantum", "agent_type": "research", "purpose": "Research agent for the following keywords: quantum computing, latest research in Melbourne, Australia. Search for relevant information, analyse patterns and trends, and present clear findings for each keyword.", "expect": {"tools_any": ["search", "fetch"], "persona": true}}
{"id": "research_multi_keyword", "agent_type": "research", "purpose": "Research agent for the following keywords: ai engineer, AI engineering, software engineer, explain what recruiters want in Melbourne, Victoria, Australia. Search for relevant information, analyse patterns and trends, and present clear findings for each keyword.", "expect": {"tools_any": ["search", "fetch"], "persona": true}}
{"id": "job_search_melbourne", "agent_type": "job_search", "purpose": "Job search agent for the following roles or skills: help writing a cover letter, looking for a job, software engineer, ai engineer in Melbourne, Australia. Search live job listings, compare requirements and salary across postings, and present clear, ranked findings for each role or skill.", "expect": {"persona": true, "min_tools": 1}}
{"id": "general_home_repair", "agent_type": "general", "purpose": "General-purpose assistant covering the following topics: Fix a leaky shower, plumber costs, home maintenance (relevant to Melbourne, Australia). Decide what information or tools each topic needs and present clear, well-organised findings.", "expect": {"persona": true, "min_tools": 1}}
// Hand-written cases that should pull a specific vetted MCP server rather than generated code.
{"id": "timezone_planner", "agent_type": "general", "purpose": "Help me schedule calls with colleagues in Melbourne, London and San Francisco by telling me the current time in each city and suggesting overlapping working hours.", "expect": {"mcp_servers": ["time"], "persona": true}}
{"id": "url_summariser", "agent_type": "general", "purpose": "Summarise any web page whose URL I paste in, in five bullet points, and list any dates or prices it mentions.", "expect": {"tools_any": ["fetch", "extract"], "persona": true}}
// Robustness: vague or self-contained purposes that need little or no tooling.
{"id": "vague_purpose", "agent_type": "general", "purpose": "help me", "expect": {"persona": true}}
{"id": "running_log", "agent_type": "general", "purpose": "Track my weekly running distances from what I tell you, keep a running total, and save a weekly summary file I can download.", "expect": {"tools_any": ["save"], "persona": true}}
