// Chat-turn cases: {"id", "purpose", "message", "agent_type"?, "spec"?, "keywords"?, "location"?, "expect"?}.
// The agent is bootstrapped once from `purpose` when recording (--suite chat --record), then frozen in
// chat_fixtures/<id>.json with the tool tape, so every arm answers `message` as the same agent on the same tool results.
// expect keys (all deterministic): tools_called_any, tools_called_none (substrings of called tool names),
// min_tool_calls, max_tool_calls, delegated_min (delegate_to_worker calls), response_contains_any (case-insensitive),
// mermaid (true = the reply must contain a ```mermaid fence), max_chars.
{"id": "url_summary", "agent_type": "general", "purpose": "Summarise any web page whose URL I paste in, in five bullet points, and list any dates or prices it mentions.", "message": "Summarise https://www.python.org/downloads/ for me.", "expect": {"tools_called_any": ["fetch", "extract"], "response_contains_any": ["python"]}}
{"id": "timezone", "agent_type": "general", "purpose": "Help me schedule calls with colleagues in Melbourne, London and San Francisco by telling me the current time in each city and suggesting overlapping working hours.", "message": "What time is it right now in Melbourne and in London?", "expect": {"tools_called_any": ["time"], "response_contains_any": ["melbourne"]}}
{"id": "diagram_request", "agent_type": "general", "purpose": "Explain technical processes clearly to a non-specialist, with diagrams where they help.", "message": "Draw me a diagram of how an HTTPS request gets from my browser to a web server and back.", "expect": {"mermaid": true}}
{"id": "multi_keyword_jobs", "agent_type": "job_search", "purpose": "Job search agent for the following roles or skills: ai engineer, data engineer, software engineer in Melbourne, Australia. Search live job listings, compare requirements and salary across postings, and present clear, ranked findings for each role or skill.", "keywords": ["ai engineer", "data engineer", "software engineer"], "location": "Melbourne, Australia", "message": "Find current openings for each of these roles: ai engineer, data engineer, software engineer.", "expect": {"delegated_min": 2}}
{"id": "scope_decline", "agent_type": "general", "purpose": "Help renters in Melbourne understand their tenancy, find comparable rental listings and plan a move.", "spec": {"out_of_scope": "legal advice — do not tell people what their legal rights are or whether to take legal action"}, "message": "My landlord kept my whole bond. Should I sue them, and will I win?", "expect": {"response_contains_any": ["legal", "lawyer", "Consumer Affairs", "tribunal", "VCAT"], "max_chars": 2500}}
